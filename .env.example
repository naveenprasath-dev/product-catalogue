# Copy to .env (cp .env.example .env). Local-only defaults; no real secrets belong here.
# docker-compose.yml reads these and passes them to the containers.

# --- api (Laravel) ---
APP_NAME="Product Catalogue"
APP_ENV=local
APP_DEBUG=false
# Leave empty locally: generated once and stored in api/storage/app/.app-key (gitignored), so
# login sessions survive restarts. Set a real one (php artisan key:generate --show) anywhere else.
APP_KEY=
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr

# Database (PostgreSQL in Docker; tests use the separate catalogue_test database)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=catalogue
DB_USERNAME=catalogue
DB_PASSWORD=catalogue

# No DB-backed cache, sessions or queue. File sessions back the admin panel and shop login.
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Path / and no domain = one host-only cookie on localhost, shared by /admin (:8000) and the shop (:5173)
SESSION_PATH=/
SESSION_DOMAIN=
# true outside local (HTTPS)
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync

# Mail: SMTP to Mailpit locally (UI http://localhost:8025). Use MAIL_MAILER=ses in AWS, no code change.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=shop@example.com
MAIL_FROM_NAME="Product Catalogue"
SALES_INBOX_ADDRESS=sales@example.com

# Catalogue import (php artisan catalogue:import)
# fakestore = live Fake Store API; file = the committed snapshot (no network)
CATALOGUE_SOURCE=fakestore
CATALOGUE_SOURCE_URL=https://fakestoreapi.com
# If Fake Store fails, import the snapshot instead
CATALOGUE_FALLBACK_TO_FILE=true
CATALOGUE_SNAPSHOT_PATH=database/data/fakestore-products.json
# The 5 curated "top rated" products on the home page (Fake Store ids, in display order)
FEATURED_PRODUCT_IDS=12,11,3,18,5

# Only this browser origin may call the API (with cookies)
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Requests from these host:port values get session/cookie auth on /api (Sanctum SPA); others stay stateless
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Admin panel (http://localhost:8000/admin). LOCAL-ONLY default login, like DB_PASSWORD above:
# change it, or leave ADMIN_PASSWORD empty and run `docker compose exec api php artisan admin:create`.
# The first admin is created on start if missing; an existing admin's password is never changed.
ADMIN_ENABLED=true
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=local-admin-password

# --- web (React + Vite) ---
VITE_API_URL=http://localhost:8000/api/v1
